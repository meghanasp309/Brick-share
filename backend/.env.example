# Copy this file to ".env" and change values if you need to.
# Every value below already has the same default in src/config.js,
# so the server also runs without a .env file on your laptop.

PORT=4000
DATABASE_URL=postgres://brickshare:brickshare@localhost:5432/brickshare

# Secrets. Change these for anything that isn't your own laptop.
JWT_SECRET=dev-jwt-secret-change-me
WALLET_SECRET=dev-wallet-secret-change-me

# Our private Besu network (start it from the network/ folder).
BESU_RPC_URL=http://127.0.0.1:8545

# DEV-ONLY keys from contracts/hardhat.config.js. They are public on GitHub.
PLATFORM_KEY=0xc710504cb32fc979d5080a3b5215f07ad8b33b58743876aaf695588ec9cf1ba7
LAND_AUTHORITY_KEY=0xe028742a957ee5873864d789b2fbf1463b1184418da5d650d33c6f8b3f9291f1

# Accounts created on first start.
ADMIN_EMAIL=admin@brickshare.test
ADMIN_PASSWORD=admin123
LAND_AUTHORITY_EMAIL=land@brickshare.test
LAND_AUTHORITY_PASSWORD=land123

# Where uploaded ID cards and property papers are saved.
UPLOAD_DIR=uploads

# Razorpay TEST mode keys, from https://dashboard.razorpay.com (Test Mode > API Keys).
# Leave both empty to use fake payments: no Razorpay account needed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Minutes an unpaid order keeps its shares reserved.
ORDER_MINUTES=15
